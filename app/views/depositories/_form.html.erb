<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= form.select :subtype,
                 Depository::SUBTYPES.map { |k, v| [v[:long], k] },
                 { label: true, prompt: t("depositories.form.subtype_prompt"), include_blank: t("depositories.form.none") } %>

  <%= form.fields_for :accountable do |depository_form| %>
    <%= depository_form.number_field :overdraft_limit,
                                     label: "Overdraft limit (optional)",
                                     placeholder: "e.g. 500",
                                     min: 0,
                                     step: 0.01 %>
    <p class="text-xs text-secondary">How far below zero the bank lets this account go. Used to show available funds; it doesn't change the balance.</p>
  <% end %>
<% end %>
